# St.NEA パイプライン 環境変数テンプレート
# このファイルを .env にコピーして値を入力してください
# .env は .gitignore に追加済み（GitHubへ公開しない）

ANTHROPIC_API_KEY=sk-ant-...

# メール送信（Gmail + アプリパスワード）
# Googleアカウント → セキュリティ → 2段階認証 → アプリパスワード で発行
# 配信先：yt2nah0@gmail.com（個人Gmail）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yt2nah0@gmail.com
SMTP_PASSWORD=your-app-password

# St.NEA パイプライン 環境変数テンプレート
# このファイルを .env にコピーして値を入力してください
# .env は .gitignore に追加済み（GitHubへ公開しない）

ANTHROPIC_API_KEY=sk-ant-...

# メール送信元（SMTPアカウント）
# Gmailの場合：Googleアカウント → セキュリティ → アプリパスワードを発行
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password

# 会社メール（独自ドメイン）のSMTPを使う場合：
# SMTP_HOST=mail.nishikawa1566.com  ← ホスティング会社に確認
# SMTP_PORT=587
# SMTP_USER=yaita-tetsuro@nishikawa1566.com
# SMTP_PASSWORD=your-password
